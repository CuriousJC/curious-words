#####Claude Code Ignore
# Project-scoped Claude Code permission allowlist. Written by approving prompts
# during a session, so it accumulates one-off command strings that never match
# again. Kept local rather than shared. `settings.local.json` is separately
# ignored globally in ~/.config/git/ignore.
#
# If this ever becomes worth sharing, it needs `git add -f`.
.claude/settings.json


#####Node / Vite Ignore
# Dependencies. Restored by `npm ci` from the committed lockfile.
node_modules/

# Vite build output. Regenerated from source on every build, so it never needs
# to live in git.
#
# Deliberately NOT anchored to a specific path yet -- the app directory does not
# exist. Once it does, narrow this to that one output directory rather than
# leaving a bare `dist/` that could swallow something unrelated later.
dist/

# Vite's dependency pre-bundling cache.
node_modules/.vite/

# Local environment overrides. `.env` itself is the one that tends to collect
# real values; the `.example` form is what gets committed as documentation.
.env
.env.local
.env.*.local
!.env.example

*.log
npm-debug.log*


#####Terraform Ignore
# Anticipatory. There is no terraform/ directory yet, but state files are the
# rule you want in place BEFORE the tool arrives rather than after: `.tfstate`
# records every resource attribute in plaintext, and a state file committed once
# stays in history even after it is deleted.

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*
#
# Worth turning on if plans ever get written to disk here. A saved plan embeds
# the resolved values of everything it touched, including whatever came out of
# variables you were careful to keep in an ignored .tfvars.

# Ignore CLI configuration files
.terraformrc
terraform.rc

# NOT ignored, deliberately: .terraform.lock.hcl
#
# The provider lock file belongs in git. It pins provider versions and their
# checksums so CI resolves exactly what you resolved locally, which is the same
# reason package-lock.json gets committed. Ignoring it means a `terraform init`
# on the runner can silently pick up a newer provider than the one you tested.


#######
# Created by https://www.toptal.com/developers/gitignore/api/visualstudiocode
# Edit at https://www.toptal.com/developers/gitignore?templates=visualstudiocode

### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide


#####OS Ignore
# Windows Explorer and macOS Finder droppings. Worth having even on a
# single-developer repo, since anyone who clones it may not be on Windows.
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
